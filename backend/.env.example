# Clave que los clientes deben mandar en el header X-API-Key (déjala vacía solo en desarrollo)
API_KEY=
ASSISTANT_NAME=Kyuuri
# Palabras que lo activan (separadas por coma): el nombre y cómo suele escribirlo Whisper
WAKE_WORDS=kyuuri,kyuri,kiuri,quiuri

# Confianza mínima (0-1) para ejecutar un comando; por debajo se conversa con el LLM
CONFIDENCE_THRESHOLD=0.6
# Confianza mínima para ejecutar algo en el equipo; las preguntas nunca ejecutan acciones
ACTION_CONFIDENCE_THRESHOLD=0.8
INTENT_BASE_MODEL=dccuchile/bert-base-spanish-wwm-uncased

# Voz (versión ligera: openai/whisper-small)
WHISPER_MODEL=openai/whisper-large-v3-turbo
PIPER_VOICE=es_MX-claude-high
# Parte del nombre del micrófono (vacío = el predeterminado). Lista: python -m app.voice --microfonos
MIC_DEVICE=

# LLM local con Ollama (elegido por pruebas; versión ligera: qwen3:1.7b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Guardar lo que le dices en data/interactions.jsonl para reentrenar con tus frases (solo en tu equipo)
LOG_INTERACTIONS=true
